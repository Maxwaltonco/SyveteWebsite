# Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key, NOT the anon key. Server-only, never expose to the browser.

# Your public site URL (used for Stripe redirect + webhook target)
NEXT_PUBLIC_SITE_URL=https://your-domain.com.au

# Admin dashboard password (pick something strong, not your Instagram password)
ADMIN_PASSWORD=change-me

# Instagram handle shown/linked across the site (with or without leading @)
NEXT_PUBLIC_INSTAGRAM_HANDLE=@syvete

# Google Workspace SMTP for transactional emails (payment received, spot
# confirmed, application refunded). GMAIL_APP_PASSWORD is a 16-character App
# Password (Google Account -> Security -> 2-Step Verification -> App
# passwords) — not the actual account password.
GMAIL_USER=events@syvete.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Telegram bot that DMs a new-order alert the instant a payment comes in.
# TELEGRAM_BOT_TOKEN comes from @BotFather. TELEGRAM_CHAT_ID is a
# comma-separated list of numeric chat ids, one per recipient — each person
# messages the bot once, then you look up their chat id by hitting
# https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789,987654321
