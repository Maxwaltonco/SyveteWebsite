# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key, NOT the anon key. Server-only, never expose to the browser.

# Your public site URL (used for Stripe redirect + webhook target)
